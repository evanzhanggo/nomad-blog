{
  "name": "nomad-blog",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0 --port 4391 --local",
    "build": "wrangler deploy --dry-run --outdir dist && node scripts/finalize-bundle.mjs",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "db:local": "wrangler d1 migrations apply DB --local"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4",
    "wrangler": "4.166.0"
  }
}
